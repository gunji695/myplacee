{
  "name": "myplacee",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run build:github-pages",
    "build:github-pages": "node -e \"const fs = require('fs'); const path = require('path'); const src = 'docs/browser'; const dest = 'docs'; fs.readdirSync(src).forEach(f => { const srcPath = path.join(src, f); const destPath = path.join(dest, f); if (fs.lstatSync(srcPath).isDirectory()) { fs.cpSync(srcPath, destPath, {recursive: true}); } else { fs.copyFileSync(srcPath, destPath); } }); console.log('✓ Build files copied to docs/');\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:myplacee": "node dist/myplacee/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}